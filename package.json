{
  "name": "handback",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "genlayer",
    "contract:lint": ".venv/bin/genvm-lint check contracts/handback.py",
    "contract:test": ".venv/bin/pytest tests/direct -v",
    "network:check": "node scripts/check-network.mjs",
    "verify": "npm run network:check && npm run typecheck && npm run lint && npm test && npm run contract:test && npm run build"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "next": "^16.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.37.0",
    "eslint-config-next": "^16.4.0",
    "genlayer": "0.39.1",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
